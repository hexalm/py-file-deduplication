def init(
    project_root: Path, 
    destination_root: str = "ProtonDrive",
):
    config, conn, db_path = _resolve_config_and_db(project_root)
    print(f"Database: {db_path}")
    print("")
    #TODO: dest from config

    cursor: sqlite3.Cursor = iter_all_files(conn)
    scanned_files = [f.rel_path for f in enumerate(cursor, start=1)]
    
    source_files = [f for f in scanned_files if not f.startswith(destination_root)]
    # duplicate_groups = build_duplicate_groups(conn)
    duplicate_groups = build_copy_groups(conn, source_files)

    plan_copies(
        scanned_files,
        duplicate_groups,
        destination_root,
    )


